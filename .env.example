NODE_ENV=development
PORT=5000
APP_ORIGIN=http://localhost:5173
# Transactions are required. Use MongoDB Atlas or the included replica-set Docker setup.
MONGO_URI=mongodb://127.0.0.1:27017/aps_erp?replicaSet=rs0
OTP_SECRET=replace-with-at-least-32-random-characters
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=APS ERP <noreply@example.edu>
# Only for local development. OTPs are printed in the server terminal.
DEV_OTP_CONSOLE=false
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_NAME=Campus Administrator
